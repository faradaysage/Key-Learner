__pycache__/
*.pyc

# Generated Unity copies of finalized voice packs; canonical data lives in Content/Voice.
UnityPort/Assets/StreamingAssets/Content/Voice/Packs/
UnityPort/Assets/StreamingAssets/Content/Voice/Packs.meta
UnityPort/Assets/StreamingAssets/Content/Voice/voice-packs.json*
